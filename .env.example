# -----------------------------------------------------------------------------
# Supabase — Project Settings › API
# -----------------------------------------------------------------------------

# Safe to expose. Shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SECRET. Bypasses every row-level security policy.
# Server-side only — never prefix with NEXT_PUBLIC_, never commit a real value.
# Use a separate Supabase project/key per environment. Local development needs
# its local service-role key; never copy the production key into previews.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Site
# -----------------------------------------------------------------------------

# Canonical origin, no trailing slash. Used for metadata, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=https://martersandco.com

# Exact registered entity name from the licence. Leave blank to display the
# brand name without asserting an unverified legal suffix.
NEXT_PUBLIC_LEGAL_NAME=

# Printed in the footer and the About page when set. Use the exact number on
# the DIFC commercial licence; leave blank until it has been verified.
NEXT_PUBLIC_DIFC_LICENCE=

# Public contact details. Leave phone values empty to hide phone links until a
# real business number is ready; keep the E.164 value free of spaces.
NEXT_PUBLIC_CONTACT_EMAIL=hello@martersandco.com
NEXT_PUBLIC_PHONE_DISPLAY=
NEXT_PUBLIC_PHONE_E164=

# SECRET. Used to create a non-reversible HMAC/SHA-256 rate-limit key from a
# requester address. Generate at least 32 random bytes; never expose publicly.
CONTACT_RATE_LIMIT_SECRET=

# -----------------------------------------------------------------------------
# WhatsApp OTP — infrastructure is built, the feature is off.
# Leave WHATSAPP_PROVIDER unset (or "console") until you are ready to send.
# -----------------------------------------------------------------------------

# console | meta
WHATSAPP_PROVIDER=console

# Required only when WHATSAPP_PROVIDER=meta
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_TOKEN=
META_WHATSAPP_TEMPLATE=otp_code
META_WHATSAPP_TEMPLATE_LOCALE=en
